JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=
JIRA_PROJECT_KEY=PROJ

MCP_AUTH_TOKEN=
PORT=8080

# Optional overrides — only needed if field auto-detection fails
# (e.g. the "Epic Link" / "Story Points" fields were renamed).
JIRA_EPIC_LINK_FIELD=
JIRA_STORY_POINTS_FIELD=

# Optional: route outbound requests to Jira through an HTTP proxy.
# Standard Go environment variables — leave unset if not needed.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
